---
import NsMonogram from './NsMonogram.astro';
// Absolute hashes so the same nav works on the start page and one click deep.
// Scroll state (.solid) and the active-section marker are driven by
// src/scripts/chrome.ts; this component is pure markup.
const LINKS = [
  ['#work', 'Work'],
  ['#projects', 'Projects'],
  ['#index', 'Index'],
  ['#skills', 'Skills'],
  ['#about', 'About'],
  ['#contact', 'Contact'],
] as const;
---

<nav id="nav" aria-label="Site navigation" transition:persist="nav">
  <a class="nav-mark" href="/#top" aria-label="Nico Sutheimer — home">
    <NsMonogram combined />
    <span>NS</span>
  </a>

  <div class="nav-links" aria-label="Page sections">
    {LINKS.map(([href, label]) => <a href={`/${href}`}>{label}</a>)}
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s;
  }

  nav.solid {
    background-color: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--line-soft);
  }

  .nav-mark {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
  }

  /* The SVG inherits currentColor from parent — accent via global `a` colour */
  .nav-mark :global(svg) {
    color: var(--accent);
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .nav-mark:hover :global(svg) { transform: rotate(-8deg) scale(1.08); }

  .nav-links {
    display: flex;
    gap: 26px;
    font-size: 13px;
    letter-spacing: 0.05em;
  }

  .nav-links a {
    position: relative;
    padding: 4px 0;
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.2s;
  }

  /* active-section marker: a hairline that grows from the left */
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .nav-links a:hover { color: var(--accent); }
  .nav-links a[aria-current="true"] { color: var(--ink); }
  .nav-links a[aria-current="true"]::after { transform: scaleX(1); }

  .nav-links a:focus-visible,
  .nav-mark:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .nav-links { display: none; }
  }
</style>
