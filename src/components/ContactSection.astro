---
// ContactSection.astro
// Private contact channels only; the employer address must not appear on the public site.
---

<section id="contact" class="contact-sec">
  <div class="wrap">
    <div class="contact-header reveal">
      <div class="eyebrow contact-eyebrow">Get in touch</div>
      <h2 class="sec-title" data-decode>Let's build something that reads the data right.</h2>
    </div>
    <div class="term reveal">
      <div class="term-bar">
        <span class="d g"></span>
        <span class="d"></span>
        <span class="d"></span>
        <span class="t">nico@portfolio: ~/contact</span>
      </div>
      <div class="term-body" data-stagger>
        <div><span class="cm"># reach out — pick a channel</span></div>
        <div><span class="pr">&gt;</span> mail&nbsp;&nbsp;&nbsp;&nbsp;<a href="mailto:sutheimer.nico@gmail.com">sutheimer.nico@gmail.com</a></div>
        <div><span class="pr">&gt;</span> linkedin&nbsp;<a href="https://www.linkedin.com/in/nico-sutheimer-5b50a82b9/" rel="noopener noreferrer">in/nico-sutheimer-5b50a82b9</a></div>
        <div><span class="pr">&gt;</span> github&nbsp;&nbsp;<a href="https://github.com/sutheimernico" rel="noopener noreferrer">github.com/sutheimernico</a></div>
        <div><span class="pr">&gt;</span> source&nbsp;&nbsp;<a href="https://github.com/sutheimernico/sutheimernico.github.io" rel="noopener noreferrer">this site, as a repo</a></div>
        <div><span class="pr">&gt;</span> <span class="cur">_</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-sec {
    padding: 16vh 0 10vh;
    border-top: 1px solid var(--line-soft);
  }

  .contact-header {
    text-align: center;
    margin-bottom: 36px;
  }

  .contact-eyebrow {
    justify-content: center;
  }

  .term {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: linear-gradient(180deg, var(--surface), var(--bg-warm));
    overflow: hidden;
    max-width: 720px;
    margin: 0 auto;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  .d {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line);
  }

  .d.g {
    background: var(--accent-soft);
  }

  .t {
    margin-left: 10px;
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    font-family: var(--mono);
  }

  .term-body {
    padding: 28px 26px;
    font-size: 14.5px;
    line-height: 2;
    font-family: var(--mono);
  }

  /* lines print in as the terminal scrolls into view — CSS only, visible without JS */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .term-body > div {
        animation: lineIn 1ms linear both;
        animation-timeline: view();
        animation-range: entry calc(10% + var(--i, 0) * 6%) entry calc(45% + var(--i, 0) * 6%);
      }
    }
  }
  @keyframes lineIn { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }

  .pr {
    color: var(--accent);
  }

  .cm {
    color: var(--ink-faint);
  }

  .term-body a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, color 0.2s;
  }

  .term-body a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .term-body a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .cur {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cur { animation: none; }
  }
</style>
