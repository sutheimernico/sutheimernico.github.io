---
/**
 * Landing v2 — static HTML and CSS only. No React runtime, no canvas, no per-frame
 * script: the scroll-driven 3D ride that used to live here moved to /descent (design lab)
 * because it held ~30 fps on a throttled CPU. Motion here is a one-off load sequence plus
 * hover states, all transform/opacity. The ride itself is listed under Projects.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ProjectList from '../components/ProjectList.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SKILL_AREAS, evidenceFor } from '../lib/skills';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const listProjects = projects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  status: p.data.status,
  year: p.data.year,
  stack: p.data.stack,
  summary: p.data.summary,
  domain: p.data.domain,
  context: p.data.context,
}));

const evidenceProjects = projects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  order: p.data.order,
  stack: p.data.stack,
  context: p.data.context,
}));
const areas = SKILL_AREAS.map((a) => ({ ...a, ...evidenceFor(a, evidenceProjects, 4) }));
---
<Base>
  <Nav />

  <main id="main">
    <header class="hero" id="top">
      <div class="wrap">
        <p class="prompt" aria-hidden="true"><span class="ps">nico@osnabrück</span> <span class="tilde">~</span> $ whoami<span class="cur"></span></p>
        <h1 class="h-name"><span>Nico</span> <span>Sutheimer</span></h1>
        <p class="h-role">Fullstack Developer <span class="h-stack">Python · FastAPI · React · TypeScript</span></p>
        <p class="h-lede">
          By day I wire data products end to end at bekumoo: from the dbt model through the API
          into the React frontend. After hours I build things that have to prove they work.
        </p>
        <div class="h-cta">
          <a class="btn primary" href="#projects">See the projects</a>
          <a class="btn" href="#contact">Get in touch</a>
          <a class="btn" href="/lebenslauf-nico-sutheimer.pdf" download>CV (PDF, German)</a>
        </div>
        <p class="h-meta">
          <span>Osnabrück</span><span>bekumoo since 2023</span><span>B.Sc. Wirtschaftsinformatik</span>
        </p>
      </div>
    </header>

    <section class="index-sec" id="projects">
      <div class="wrap">
        <div class="reveal">
          <div class="eyebrow">Projects</div>
          <h2 class="sec-title">Everything I've built.</h2>
          <p class="sec-lede">Day job and side projects in one list. Filter by area, open any row for the full write-up.</p>
        </div>
        <ProjectList projects={listProjects} />
      </div>
    </section>

    <section class="skills-sec" id="skills">
      <div class="wrap">
        <div class="reveal">
          <div class="eyebrow">Skills</div>
          <h2 class="sec-title">Fullstack, with data at the core.</h2>
          <p class="sec-lede">
            From the dbt model through the API to the screen. Six areas I work in, each with the
            projects that show it. The counts come from the project list, not from a self-rating.
          </p>
        </div>
        <ul class="areas">
          {areas.map((a) => (
            <li class="area">
              <div class="a-head">
                <h3 class="a-label">{a.label}</h3>
                <span class="a-count">{a.count} {a.count === 1 ? 'project' : 'projects'}</span>
              </div>
              <p class="a-blurb">{a.blurb}</p>
              <ul class="a-tools" aria-label={`${a.label} tools`}>
                {a.tools.map((t) => <li class="chip">{t}</li>)}
              </ul>
              {a.shown.length > 0 && (
                <p class="a-proof">
                  <span class="a-proof-cap">shown in</span>
                  {a.shown.map((p) => (
                    <a href={`/projects/${p.slug}`}>
                      {p.title}{p.context === 'work' && <span class="a-work">@ bekumoo</span>}
                    </a>
                  ))}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <AboutSection />
    <ContactSection />
  </main>

  <SiteFooter />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    min-height: min(100svh, 920px);
    display: flex;
    align-items: center;
    padding: 120px 0 72px;
    border-bottom: 1px solid var(--line-soft);
  }

  .prompt {
    margin: 0 0 18px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }
  .ps { color: var(--accent); }
  .tilde { color: var(--accent-2); }
  .cur {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 6px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .h-name {
    margin: 0;
    font-family: var(--disp);
    font-weight: 700;
    font-size: clamp(44px, 9.2vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  .h-name span { display: inline-block; }

  .h-role {
    margin: 26px 0 0;
    font-family: var(--disp);
    font-size: clamp(16px, 1.8vw, 21px);
    font-weight: 500;
    color: var(--accent);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
  }
  .h-stack {
    font-family: var(--mono);
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }

  .h-lede {
    margin: 22px 0 0;
    max-width: 58ch;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.7;
    color: var(--ink-dim);
  }

  .h-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    border-radius: 8px;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out),
      transform 120ms var(--ease-out);
  }
  .btn:hover { border-color: var(--accent-soft); }
  .btn:active { transform: scale(0.97); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--bg); font-weight: 500; }
  .btn.primary:hover { background: color-mix(in srgb, var(--accent) 86%, var(--ink)); }
  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .h-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 44px 0 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .h-meta span + span::before { content: "/"; margin-right: 22px; color: var(--line); }
  @media (max-width: 520px) { .h-meta { flex-direction: column; } .h-meta span + span::before { content: none; } }

  /* one-off load sequence: lines print in top to bottom, transform/opacity only */
  @media (prefers-reduced-motion: no-preference) {
    .prompt, .h-name span, .h-role, .h-lede, .h-cta, .h-meta {
      animation: printIn 0.7s var(--ease-out) both;
    }
    .h-name span:nth-child(1) { animation-delay: 0.12s; }
    .h-name span:nth-child(2) { animation-delay: 0.2s; }
    .h-role { animation-delay: 0.32s; }
    .h-lede { animation-delay: 0.4s; }
    .h-cta { animation-delay: 0.48s; }
    .h-meta { animation-delay: 0.56s; }
  }
  @keyframes printIn { from { opacity: 0; transform: translateY(14px); } }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- index ---------- */
  .index-sec { padding: 10vh 0 12vh; }

  .sec-lede {
    margin: 16px 0 0;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-dim);
  }

  /* ---------- skills ---------- */
  .skills-sec { padding: 10vh 0 12vh; border-top: 1px solid var(--line-soft); }
  .areas {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 1000px) { .areas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .areas { grid-template-columns: 1fr; } }
  .area {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 24px 22px;
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent-soft);
    border-radius: 12px;
    background: var(--surface);
  }
  .a-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .a-label {
    margin: 0;
    font-family: var(--disp);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .a-count {
    flex: 0 0 auto;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .a-blurb { margin: 0; font-size: 14px; line-height: 1.65; color: var(--ink-dim); }
  .a-tools { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .a-tools .chip { font-size: 11.5px; color: var(--ink); }
  .a-proof {
    margin: auto 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    font-size: 12.5px;
  }
  .a-proof-cap {
    width: 100%;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .a-proof a {
    color: var(--ink-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .a-proof a:hover { color: var(--accent); border-bottom-color: var(--accent-soft); }
  .a-proof a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .a-work { margin-left: 6px; font-size: 10.5px; color: var(--accent-soft); }
</style>
