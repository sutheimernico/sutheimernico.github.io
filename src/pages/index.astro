---
/**
 * Landing v2 — static HTML and CSS only. No React runtime, no canvas, no per-frame
 * script: the scroll-driven 3D ride that used to live here moved to /descent (design lab)
 * because it held ~30 fps on a throttled CPU. Motion here is a one-off load sequence plus
 * hover states, all transform/opacity.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ProjectList from '../components/ProjectList.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { DOMAINS, domainLabel, topStack } from '../lib/domains';
import type { ProjectStatus } from '../lib/projectSchema';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const LAB_SLUG = 'descent';
const featured = projects.filter((p) => p.data.featured && p.id !== LAB_SLUG);
const lab = projects.find((p) => p.id === LAB_SLUG);

const listProjects = projects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  status: p.data.status,
  year: p.data.year,
  stack: p.data.stack,
  summary: p.data.summary,
  domain: p.data.domain,
  context: p.data.context,
}));

const skills = topStack(projects.map((p) => p.data.stack), 18);
const domainCounts = DOMAINS.map((d) => ({
  ...d,
  n: projects.filter((p) => p.data.domain === d.id).length,
}));

const STATUS: Record<ProjectStatus, { label: string; cls: string }> = {
  production: { label: 'live', cls: 'live' },
  'in-progress': { label: 'building', cls: 'wip' },
  research: { label: 'research', cls: 'wip' },
  internal: { label: 'internal', cls: 'int' },
};
---
<Base>
  <Nav />

  <main id="main">
    <header class="hero" id="top">
      <div class="wrap">
        <p class="prompt" aria-hidden="true"><span class="ps">nico@osnabrück</span> <span class="tilde">~</span> $ whoami<span class="cur"></span></p>
        <h1 class="h-name"><span>Nico</span> <span>Sutheimer</span></h1>
        <p class="h-role">Fullstack Developer <span class="h-stack">Python · FastAPI · React · TypeScript</span></p>
        <p class="h-lede">
          By day I wire data products end to end at bekumoo: from the dbt model through the API
          into the React frontend. After hours I build things that have to prove they work.
        </p>
        <div class="h-cta">
          <a class="btn primary" href="#work">See the work</a>
          <a class="btn" href="#contact">Get in touch</a>
        </div>
        <p class="h-meta">
          <span>Osnabrück</span><span>bekumoo since 2023</span><span>B.Sc. Wirtschaftsinformatik</span>
        </p>
      </div>
    </header>

    <section class="work-sec" id="work">
      <div class="wrap">
        <div class="reveal">
          <div class="eyebrow">Selected work</div>
          <h2 class="sec-title">Built, shipped, measured.</h2>
        </div>

        <ul class="cards">
          {featured.map((p) => {
            const s = STATUS[p.data.status];
            return (
              <li class="card">
                <a href={`/projects/${p.id}`}>
                  <span class={`c-meta ${s.cls}`}>
                    <i class="led" aria-hidden="true" />
                    <span>{s.label}</span>
                    <span class="c-dot" aria-hidden="true">·</span>
                    <span>{p.data.context === 'work' ? '@ bekumoo' : domainLabel(p.data.domain)}</span>
                    <span class="c-year">{p.data.year}</span>
                  </span>
                  <span class="c-title" style={`view-transition-name: p-${p.id}`}>{p.data.title}</span>
                  <span class="c-role">{p.data.role}</span>
                  <span class="c-sum">{p.data.summary}</span>
                  <span class="c-stack">{p.data.stack.slice(0, 4).map((t) => <span class="chip">{t}</span>)}</span>
                  <span class="c-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ul>

        {lab && (
          <a class="lab" href={`/projects/${lab.id}`}>
            <span class="lab-tag">design lab</span>
            <span class="lab-copy">
              <span class="lab-title" style={`view-transition-name: p-${lab.id}`}>{lab.data.title}</span>
              <span class="lab-sum">{lab.data.summary}</span>
            </span>
            <span class="lab-go" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </section>

    <section class="index-sec" id="index">
      <div class="wrap">
        <div class="reveal">
          <div class="eyebrow">Index</div>
          <h2 class="sec-title">Everything on the bench.</h2>
        </div>
        <ProjectList projects={listProjects} skipTransitionFor={[...featured.map((p) => p.id), LAB_SLUG]} />
      </div>
    </section>

    <section class="skills-sec" id="skills">
      <div class="wrap">
        <div class="reveal">
          <div class="eyebrow">Skills</div>
          <h2 class="sec-title">Four kinds of work, one stack.</h2>
        </div>
        <ul class="domains">
          {domainCounts.map((d) => (
            <li>
              <span class="d-n">{d.n}</span>
              <span class="d-label">{d.label}</span>
              <span class="d-blurb">{d.blurb}</span>
            </li>
          ))}
        </ul>
        <p class="stack-cap">Most used across all projects</p>
        <ul class="stack">
          {skills.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>
    </section>

    <AboutSection />
    <ContactSection />
  </main>

  <SiteFooter />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    min-height: min(100svh, 920px);
    display: flex;
    align-items: center;
    padding: 120px 0 72px;
    border-bottom: 1px solid var(--line-soft);
  }

  .prompt {
    margin: 0 0 18px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }
  .ps { color: var(--accent); }
  .tilde { color: var(--accent-2); }
  .cur {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 6px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .h-name {
    margin: 0;
    font-family: var(--disp);
    font-weight: 700;
    font-size: clamp(44px, 9.2vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  .h-name span { display: inline-block; }

  .h-role {
    margin: 26px 0 0;
    font-family: var(--disp);
    font-size: clamp(16px, 1.8vw, 21px);
    font-weight: 500;
    color: var(--accent);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
  }
  .h-stack {
    font-family: var(--mono);
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }

  .h-lede {
    margin: 22px 0 0;
    max-width: 58ch;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.7;
    color: var(--ink-dim);
  }

  .h-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    border-radius: 8px;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out),
      transform 120ms var(--ease-out);
  }
  .btn:hover { border-color: var(--accent-soft); }
  .btn:active { transform: scale(0.97); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--bg); font-weight: 500; }
  .btn.primary:hover { background: color-mix(in srgb, var(--accent) 86%, var(--ink)); }
  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .h-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 44px 0 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .h-meta span + span::before { content: "/"; margin-right: 22px; color: var(--line); }
  @media (max-width: 520px) { .h-meta { flex-direction: column; } .h-meta span + span::before { content: none; } }

  /* one-off load sequence: lines print in top to bottom, transform/opacity only */
  @media (prefers-reduced-motion: no-preference) {
    .prompt, .h-name span, .h-role, .h-lede, .h-cta, .h-meta {
      animation: printIn 0.7s var(--ease-out) both;
    }
    .h-name span:nth-child(1) { animation-delay: 0.12s; }
    .h-name span:nth-child(2) { animation-delay: 0.2s; }
    .h-role { animation-delay: 0.32s; }
    .h-lede { animation-delay: 0.4s; }
    .h-cta { animation-delay: 0.48s; }
    .h-meta { animation-delay: 0.56s; }
  }
  @keyframes printIn { from { opacity: 0; transform: translateY(14px); } }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- selected work ---------- */
  .work-sec { padding: 14vh 0 10vh; }

  .cards {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 760px) { .cards { grid-template-columns: 1fr; } }

  .card a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 24px 26px 26px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-mid) var(--ease-out);
  }
  .card a:hover { border-color: var(--accent-soft); transform: translateY(-2px); }
  .card a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .c-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .c-meta.live { color: var(--accent); }
  .c-meta.wip { color: var(--wip); }
  .c-dot { color: var(--ink-faint); }
  .c-year { margin-left: auto; color: var(--ink-faint); }

  .c-title {
    margin-top: 6px;
    font-family: var(--disp);
    font-weight: 600;
    font-size: clamp(20px, 2vw, 25px);
    letter-spacing: -0.02em;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .card a:hover .c-title { color: var(--accent); }
  .c-role { font-size: 12px; font-style: italic; color: var(--accent-soft); }
  .c-sum { font-size: 14px; line-height: 1.6; color: var(--ink-dim); }
  .c-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 8px; }
  .c-arrow {
    position: absolute;
    right: 24px;
    bottom: 22px;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .card a:hover .c-arrow, .card a:focus-visible .c-arrow { opacity: 1; transform: none; }

  /* the old landing, kept as a design project */
  .lab {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 22px;
    margin-top: 16px;
    padding: 22px 26px;
    border: 1px dashed var(--accent-soft);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .lab:hover { border-style: solid; border-color: var(--accent); background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .lab:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .lab-tag {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    padding: 4px 9px;
    border-radius: 4px;
  }
  .lab-copy { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .lab-title { font-family: var(--disp); font-weight: 600; font-size: 18px; color: var(--ink); }
  .lab-sum { font-size: 13px; color: var(--ink-dim); }
  .lab-go { color: var(--accent); font-size: 18px; transition: transform var(--dur-fast) var(--ease-out); }
  .lab:hover .lab-go { transform: translateX(4px); }
  @media (max-width: 560px) {
    .lab { grid-template-columns: minmax(0, 1fr) auto; }
    .lab-tag { grid-column: 1 / -1; justify-self: start; }
  }

  /* ---------- index ---------- */
  .index-sec { padding: 10vh 0 12vh; }

  /* ---------- skills ---------- */
  .skills-sec { padding: 10vh 0 12vh; }
  .domains {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  @media (max-width: 900px) { .domains { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .domains { grid-template-columns: 1fr; } }
  .domains li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 22px 24px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .d-n {
    font-family: var(--disp);
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .d-label { font-family: var(--disp); font-size: 15px; font-weight: 600; color: var(--ink); }
  .d-blurb { font-size: 13px; line-height: 1.6; color: var(--ink-dim); max-width: 32ch; }
  .stack-cap {
    margin: 40px 0 14px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .stack .chip { font-size: 12px; padding: 6px 13px; }
</style>
