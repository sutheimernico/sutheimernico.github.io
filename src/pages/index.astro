---
/**
 * Landing v2 — static HTML and CSS only. No React runtime, no canvas, no per-frame
 * script: the scroll-driven 3D ride that used to live here moved to /descent (design lab)
 * because it held ~30 fps on a throttled CPU. Motion here is a one-off load sequence plus
 * hover states, all transform/opacity. The ride itself is listed in the index as a project.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ProjectList from '../components/ProjectList.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { DOMAINS, topStack } from '../lib/domains';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const listProjects = projects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  status: p.data.status,
  year: p.data.year,
  stack: p.data.stack,
  summary: p.data.summary,
  domain: p.data.domain,
  context: p.data.context,
}));

const skills = topStack(projects.map((p) => p.data.stack), 18);
const domainCounts = DOMAINS.map((d) => ({
  ...d,
  n: projects.filter((p) => p.data.domain === d.id).length,
}));
---
<Base>
  <Nav />

  <main id="main">
    <header class="hero" id="top">
      <div class="wrap">
        <p class="prompt" aria-hidden="true"><span class="ps">nico@osnabrück</span> <span class="tilde">~</span> $ whoami<span class="cur"></span></p>
        <h1 class="h-name"><span>Nico</span> <span>Sutheimer</span></h1>
        <p class="h-role">Fullstack Developer <span class="h-stack">Python · FastAPI · React · TypeScript</span></p>
        <p class="h-lede">
          By day I wire data products end to end at bekumoo: from the dbt model through the API
          into the React frontend. After hours I build things that have to prove they work.
        </p>
        <div class="h-cta">
          <a class="btn primary" href="#index">See the work</a>
          <a class="btn" href="#contact">Get in touch</a>
        </div>
        <p class="h-meta">
          <span>Osnabrück</span><span>bekumoo since 2023</span><span>B.Sc. Wirtschaftsinformatik</span>
        </p>
      </div>
    </header>

    <section class="index-sec" id="index">
      <div class="wrap">
        <div class="reveal">
          <div class="eyebrow">Index</div>
          <h2 class="sec-title">Everything on the bench.</h2>
        </div>
        <ProjectList projects={listProjects} />
      </div>
    </section>

    <section class="skills-sec" id="skills">
      <div class="wrap">
        <div class="reveal">
          <div class="eyebrow">Skills</div>
          <h2 class="sec-title">Four kinds of work, one stack.</h2>
        </div>
        <ul class="domains">
          {domainCounts.map((d) => (
            <li>
              <span class="d-n">{d.n}</span>
              <span class="d-label">{d.label}</span>
              <span class="d-blurb">{d.blurb}</span>
            </li>
          ))}
        </ul>
        <p class="stack-cap">Most used across all projects</p>
        <ul class="stack">
          {skills.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>
    </section>

    <AboutSection />
    <ContactSection />
  </main>

  <SiteFooter />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    min-height: min(100svh, 920px);
    display: flex;
    align-items: center;
    padding: 120px 0 72px;
    border-bottom: 1px solid var(--line-soft);
  }

  .prompt {
    margin: 0 0 18px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }
  .ps { color: var(--accent); }
  .tilde { color: var(--accent-2); }
  .cur {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 6px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .h-name {
    margin: 0;
    font-family: var(--disp);
    font-weight: 700;
    font-size: clamp(44px, 9.2vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  .h-name span { display: inline-block; }

  .h-role {
    margin: 26px 0 0;
    font-family: var(--disp);
    font-size: clamp(16px, 1.8vw, 21px);
    font-weight: 500;
    color: var(--accent);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
  }
  .h-stack {
    font-family: var(--mono);
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }

  .h-lede {
    margin: 22px 0 0;
    max-width: 58ch;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.7;
    color: var(--ink-dim);
  }

  .h-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    border-radius: 8px;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out),
      transform 120ms var(--ease-out);
  }
  .btn:hover { border-color: var(--accent-soft); }
  .btn:active { transform: scale(0.97); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--bg); font-weight: 500; }
  .btn.primary:hover { background: color-mix(in srgb, var(--accent) 86%, var(--ink)); }
  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .h-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 44px 0 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .h-meta span + span::before { content: "/"; margin-right: 22px; color: var(--line); }
  @media (max-width: 520px) { .h-meta { flex-direction: column; } .h-meta span + span::before { content: none; } }

  /* one-off load sequence: lines print in top to bottom, transform/opacity only */
  @media (prefers-reduced-motion: no-preference) {
    .prompt, .h-name span, .h-role, .h-lede, .h-cta, .h-meta {
      animation: printIn 0.7s var(--ease-out) both;
    }
    .h-name span:nth-child(1) { animation-delay: 0.12s; }
    .h-name span:nth-child(2) { animation-delay: 0.2s; }
    .h-role { animation-delay: 0.32s; }
    .h-lede { animation-delay: 0.4s; }
    .h-cta { animation-delay: 0.48s; }
    .h-meta { animation-delay: 0.56s; }
  }
  @keyframes printIn { from { opacity: 0; transform: translateY(14px); } }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- index ---------- */
  .index-sec { padding: 10vh 0 12vh; }

  /* ---------- skills ---------- */
  .skills-sec { padding: 10vh 0 12vh; }
  .domains {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  @media (max-width: 900px) { .domains { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .domains { grid-template-columns: 1fr; } }
  .domains li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 22px 24px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .d-n {
    font-family: var(--disp);
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .d-label { font-family: var(--disp); font-size: 15px; font-weight: 600; color: var(--ink); }
  .d-blurb { font-size: 13px; line-height: 1.6; color: var(--ink-dim); max-width: 32ch; }
  .stack-cap {
    margin: 40px 0 14px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .stack .chip { font-size: 12px; padding: 6px 13px; }
</style>
