---
import '@fontsource-variable/martian-mono';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { DEFAULT_THEME } from '../lib/themes';
const {
  title = 'Nico Sutheimer — AI Engineer',
  description = 'AI engineer building and operating ML-backed systems end to end — evaluation harnesses, honest statistics gates, live paper-trading ops, retrieval-augmented assistants.',
} = Astro.props;

const SITE_NAME = 'Nico Sutheimer';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// PNG, not SVG: LinkedIn/X/Slack unfurlers do not render SVG previews.
const ogImage = new URL('/og.png', Astro.site).href;
// --bg warm-black (global.css :root) — kept in sync by hand; it's a single literal.
const THEME_COLOR = '#0E0F0D';
---
<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content={THEME_COLOR} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nico Sutheimer — AI Engineer" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <ClientRouter />

  <script is:inline>
    // Runs before first paint: restore the saved accent theme (prevents a theme flash).
    // The ClientRouter swap replaces every <html> attribute with the incoming
    // page's defaults, so the same restore runs again on astro:after-swap —
    // synchronously, before the new page paints.
    (function () {
      function restoreRoot() {
        try {
          var valid = ['phosphor','petrol','amethyst','solar','molten','daylight','shift'];
          var t = localStorage.getItem('ns-theme2');
          if (valid.indexOf(t) !== -1) {
            // 'shift' is a meta-theme (animated cycling); use phosphor as the dark base
            document.documentElement.dataset.theme = t === 'shift' ? 'phosphor' : t;
          }
        } catch (_) {}
      }
      restoreRoot();
      document.addEventListener('astro:after-swap', restoreRoot);
    })();
  </script>
</head>
<body>
  <!-- Skip link: first focusable element, visually hidden until focused. Lets
       keyboard users jump past the fixed nav straight to the page content. -->
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- Scroll progress hairline, persisted across view transitions. Scanlines are
       body::before in global.css. -->
  <div class="progress" id="progress" aria-hidden="true" transition:persist="progress"></div>

  <slot />

  <script>
    import { initChrome } from '../scripts/chrome';
    import { initDescent, destroyDescent } from '../scripts/descent';
    // page-load fires on the initial load and after every client-side navigation;
    // the ride's rAF loop is torn down before the old page is swapped out.
    document.addEventListener('astro:page-load', () => {
      initChrome();
      initDescent();
    });
    document.addEventListener('astro:before-swap', destroyDescent);
  </script>
</body>
</html>
